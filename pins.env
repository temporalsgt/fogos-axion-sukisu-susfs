# Pinned inputs for the AxionOS 2.9 fogos kernel build.
# Every value that changes the resulting kernel image is pinned here.

# Kernel source used by the installed AxionOS build. /proc/version on the
# device reports 5.4.302-moto-g92683a4fde22, and this commit's short SHA is
# embedded in that release string. Axion built its kernel from this merge
# commit ("Merge branch 'LineageOS:lineage-23.2' into axion"), not from the
# current lineage-23.2 branch head.
KERNEL_REPO=https://github.com/LineageOS/android_kernel_motorola_sm6375
KERNEL_COMMIT=92683a4fde22b3d76efa18e11508af49a808bf77
EXPECTED_KERNEL_RELEASE=5.4.302-moto-g92683a4fde22

# SukiSU Ultra built-in (not LKM). This commit is the Manager v4.3.0 tree and
# is the exact revision the 5.4 compatibility patches in patches/sukisu apply
# to.
SUKISU_REPO=https://github.com/SukiSU-Ultra/SukiSU-Ultra
SUKISU_REF=builtin
SUKISU_MANAGER_VERSION=v4.3.0
SUKISU_COMMIT=f9aa2fec23c3f4a06a935f69dc04cb85b261e7f3
SUKISU_COMPAT_SHA256SUMS_SHA256=c43413441a260a7b95095585a82f001027006dfb7647d66ecaf5602a170ffd64

# SUSFS v2.4.0 kernel-side backport for Linux 5.4 and the v2.3+ inline hook
# script. Both are vendored so the build is reproducible.
SUSFS_PATCH_SHA256=2198cb59ce8b02b4d21e1ea357be63cccbe4c85f2aa55cc1000e65e4bf3b403c
SUSFS_HOOKS_SHA256=8672a6295e4c17ead3fa66fc70a3fa30b7c402acd9436c0ff16f377d27af3cf3

# Exact clang used by the installed Axion kernel:
#   Android (14054515, ... based on r563880c) clang version 21.0.0
# The AOSP prebuilt directory is published on the android16-qpr2-release
# branch. Downloading the directory tarball avoids cloning the multi-GB
# prebuilts repo.
CLANG_URL=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/refs/heads/android16-qpr2-release/clang-r563880c.tar.gz
CLANG_VERSION=clang-r563880c

# AnyKernel3 and mkbootimg are pinned to the revisions used by the previous
# fogos project, where they produced a working boot.img for header v3.
AK3_REPO=https://github.com/osm0sis/AnyKernel3
AK3_COMMIT=41f04bdb4ee30a44e429c2c1131d5e8bb32b15f1

MKBOOTIMG_REPO=https://android.googlesource.com/platform/system/tools/mkbootimg
MKBOOTIMG_COMMIT=f5c284e8998dd8a085cf027bb518b6c2b84cf744

# Stock AxionOS 2.9 boot images are no longer hosted in a separate release.
# Extract boot.img, dtbo.img, vendor_boot.img, and the GMS boot.img from the
# original Axion ROM zip when a clean rebuild of the fastboot images is
# needed. Leave these variables empty to skip the optional boot-image and
# vendor-module checks in scripts/package.sh.
STOCK_BOOT_URL=
STOCK_BOOT_SHA256=
STOCK_GMS_BOOT_URL=
STOCK_GMS_BOOT_SHA256=
STOCK_VENDOR_BOOT_URL=
STOCK_VENDOR_BOOT_SHA256=

DEVICE_CODENAME=fogos
KERNEL_VERSION=5.4
AXION_VANILLA_BUILD=axion-2.9-NOESIS-20261028-OFFICIAL-VANILLA-fogos
AXION_GMS_BUILD=axion-2.9-NOESIS-20261028-OFFICIAL-GMS-fogos
