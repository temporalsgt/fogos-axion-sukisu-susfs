# SukiSU Ultra + SUSFS options merged on top of the full AxionOS kernel
# config extracted from the running device (/proc/config.gz).
#
# The full config is used as the defconfig base so that every vendor/fogos
# option, LTO/ThinLTO/CFI setting and module symbol layout matches the kernel
# the ROM shipped with. Only the options below are changed.

CONFIG_KSU=y

CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER=y

# Keep the ABI-critical options explicit. They are already set in the stock
# config, but listing them here makes verify.sh fail loudly if a merge ever
# drops one of them.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_THREAD_INFO_IN_TASK=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Match the exact UTS_RELEASE of the installed AxionOS kernel.
# LOCALVERSION_AUTO would append the patched-tree SHA and "-dirty", changing
# the module vermagic and breaking the stock vendor modules.
CONFIG_LOCALVERSION="-moto-g92683a4fde22"
# CONFIG_LOCALVERSION_AUTO is not set
